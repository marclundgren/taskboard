rules_version = '2';

/*
  Taskboard access rules.

  A board is visible to exactly the uids in its memberIds. A "private" board is
  one where that list is just you.

  Boards can also carry pendingEmails: people invited before they had an
  account. Someone whose verified email is on that list may read the board and
  perform exactly one write — adding themselves to memberIds and taking their
  address off pendingEmails. After that they are an ordinary member.

  Deploy with:  firebase deploy --only firestore:rules
  (or paste this file into Firebase console -> Firestore Database -> Rules)
*/
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(board) {
      return signedIn() && request.auth.uid in board.memberIds;
    }

    /** Verified-email holder named in this board's pending invitations. */
    function isInvited(board) {
      return signedIn()
             && request.auth.token.email != null
             && request.auth.token.email_verified == true
             && 'pendingEmails' in board
             && request.auth.token.email.lower() in board.pendingEmails;
    }

    /** The one write an invitee may make: swap their invitation for membership. */
    function isClaimingInvite() {
      return isInvited(resource.data)
             && request.resource.data.ownerId == resource.data.ownerId
             && request.auth.uid in request.resource.data.memberIds
             && request.resource.data.memberIds.hasOnly(resource.data.memberIds.concat([request.auth.uid]))
             && request.resource.data.pendingEmails.hasOnly(resource.data.pendingEmails)
             && !(request.auth.token.email.lower() in request.resource.data.pendingEmails);
    }

    function boardData(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId)).data;
    }

    // Profile cards, so members of a shared board can see each other's name.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // email -> uid, so an existing account can be invited straight to a board.
    // Readable by any signed-in user; each person may only claim their own email.
    match /emailIndex/{email} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /boards/{boardId} {
      allow read: if isMember(resource.data) || isInvited(resource.data);

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;

      // Any member may edit the board (columns, labels, invitations). Ownership
      // is fixed: a member cannot promote themselves to owner.
      allow update: if (isMember(resource.data)
                        && request.resource.data.ownerId == resource.data.ownerId)
                    || isClaimingInvite();

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Cards are for members only — an invitee sees nothing until they claim.
      match /tasks/{taskId} {
        allow read, write: if isMember(boardData(boardId));
      }
    }
  }
}
